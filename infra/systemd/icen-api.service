[Unit]
Description=ICEN Application API (FastAPI / uvicorn)
After=network.target

[Service]
Type=simple
User=icen
Group=icen
WorkingDirectory=/srv/icen/server
EnvironmentFile=/etc/icen.env
ExecStart=/srv/icen/server/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8731
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/icen/data

[Install]
WantedBy=multi-user.target
